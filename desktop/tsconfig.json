{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noEmit": true,
    "jsx": "react-jsx", "jsxImportSource": "preact", "skipLibCheck": true,
    "allowJs": true, "esModuleInterop": true, "types": ["node"]
  },
  "include": ["src/**/*"]
}
